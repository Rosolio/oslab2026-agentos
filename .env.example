# 变量需导出到 shell；程序不会自动加载 .env。
AGENTOS_INPUT=var/materials
AGENTOS_DATA=var/data
# mock 为离线演示；真实生成请改成 openai 并填写密钥。
AGENTOS_PROVIDER=mock
AGENTOS_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AGENTOS_QUESTION_COUNT=5
AGENTOS_TIMEOUT=60
AGENTOS_MAX_RETRIES=3
AGENTOS_RETRY_DELAY=5
